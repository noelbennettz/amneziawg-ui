# Copy to `.env` and change the password. `docker compose` reads `.env` from the
# directory you run it in. Every value below is a default the image already
# carries, so leaving a line out changes nothing; an empty file behaves like an
# untouched image.

# Image to run. `make deploy` overrides this with its locally built tag.
IMAGE=ghcr.io/noelbennettz/amneziawg-ui:latest

# Host ports, published by docker-compose.yml. Keep both sides equal to the
# container's ports: the image's health check asks 127.0.0.1 on WEB_UI_PORT.
WEB_UI_PORT=54845
DEFAULT_PORT=54844

# Panel login. WEB_UI_PASSWORD is base64(sha256(password)), not the password:
#   printf 'your-password' | openssl dgst -binary -sha256 | base64
# The value below is "changeme"; replace it before the port is reachable.
WEB_UI_USER=admin
WEB_UI_PASSWORD=BXugPWxEEEhj3HNh/kV4ll0YhzYPkKCJWILlimJI/IY=

# Optional switches, described in DOCS.md -> "Environment variables":
# WEB_UI_SECURE_COOKIE=true      # behind a TLS proxy that does not send X-Forwarded-Proto
# WEB_UI_AUDIT_LOG=true          # log logins and every API change
# WEB_UI_AUDIT_RETENTION_HOURS=24
# WEB_UI_LOGIN_RATE_LIMIT=true   # only behind a proxy that forwards the client address
# WEB_UI_TRUST_PROXY=true
# AUTO_START_SERVERS=true
# DEFAULT_MTU=1280
# DEFAULT_SUBNET=10.0.0.0/24
# DEFAULT_DNS=8.8.8.8,1.1.1.1
